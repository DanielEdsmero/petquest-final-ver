{
  "expo": {
    "name": "PetQuest",
    "slug": "petquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petquest",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F0",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourresearchgroup.petquest"
    },
    "android": {
      "package": "com.yourresearchgroup.petquest",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PetQuest uses the camera to photograph evidence that you completed a quest.",
          "photosPermission": "PetQuest lets you choose an existing photo as evidence that you completed a quest."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
