# ─────────────────────────────────────────────────────────────
#  PetQuest mobile — PUBLIC values only.
#  Copy to `.env` (git-ignored) and fill in.
#
#  Everything EXPO_PUBLIC_* is inlined into the JS bundle and is
#  readable by anyone with the app. That is fine for these three:
#  Supabase's anon key is public by design and Row Level Security
#  is what actually protects the data.
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Origin of the deployed Vercel app that hosts /api/validate-quest and /api/verify.
EXPO_PUBLIC_API_BASE_URL=https://your-vercel-domain.vercel.app

# ─────────────────────────────────────────────────────────────
#  NEVER put these here, or anywhere in apps/mobile/.
#  They live only in Vercel's server-side environment:
#
#    SUPABASE_SERVICE_ROLE_KEY   ← bypasses every RLS policy
#    GEMINI_API_KEY              ← billable, raw model access
#
#  The app reaches Gemini only through the server endpoints,
#  which verify the caller's Supabase access token.
# ─────────────────────────────────────────────────────────────
